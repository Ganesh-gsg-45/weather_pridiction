# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variable reference for GOOD WEATHER
#
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# OpenWeatherMap API key (required for live weather fetching on the /weather route)
# Get yours at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# Flask server port (default: 5000)
PORT=5000

# Enable Flask debug mode — set to "true" only in local development, never in production
FLASK_DEBUG=false
